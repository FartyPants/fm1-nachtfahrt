# 1.3.0's pages: the round in the panel's order (FX ENV LFO GLO / HOME SAVE ARP SEQ), the Noise page on it; the
# layers' levels on OCT- / OCT+ (a layer's page; held: on) and PERFORM's mix only; OCT- + OCT+ together, quickly:
# a true mute (the level kept), as PERFORM's white 1-5; the new knobs (Throws, Ghost, Notes, Hats; the Noise page's
# Level; the pings' Octave on the Pings page); a 1.3.0 ladder project (format 12) read
listen
wait 1000
# (Basic's chord at 76, as these numbers were written for)
tap SEL
key w5 down
spin K1 -100
spin K1 76
key w5 up
tap HOME
expect par0 76
# SELECT's round: Space, Chord, Bass, Setup, Dub, Noise, Pings, Drums (and at its ends it stays)
tap FX
wait 100
expect view 5
shot round_space.png
turn SELECT -1 100
expect view 5
turn SELECT 1 100
expect view 1
turn SELECT 1 100
expect view 3
turn SELECT 1 100
expect view 6
turn SELECT 1 100
expect view 0
turn SELECT 1 100
expect view 19
wait 100
shot round_noise.png
turn SELECT 1 100
expect view 2
turn SELECT 1 100
expect view 4
wait 100
shot round_drums.png
turn SELECT 1 100
expect view 4
turn SELECT -3 100
expect view 0
# SAVE from the Chord page: the Noise page; SELECT goes on from the Noise page's own place (Pings); SAVE again stays
tap ENV
tap SAVE
expect view 19
turn SELECT 1 100
expect view 2
tap HOME
turn SELECT 1 100
expect view 19
tap SAVE
expect view 21
tap HOME
expect view 0
# from a sound page and from PERFORM: on from its layer's page (SELECT leaves PERFORM; so does a page's button,
# to that page's first, the keys the scale again)
tap SEQ
tap SEQ
expect view 11
turn SELECT -1 100
expect view 2
tap SEL
turn SELECT -1 100
expect view 19
said PERFORM OFF
tap SEL
wait 200
expect view 17
tap ARP
wait 300
said PERFORM OFF
expect view 2
tap HOME
wait 300
# the knobs: Density first on every layer's page; Chord's Throws and Wet, Pings' Octave and Wet, Bass's Density (and
# Groove's five), Drums' Density (the kick) and Hats, Noise's Density and Level
tap ENV
wait 300
said Chord page, voice Saws: Density 30, Throws 70, Wet 45, Cutoff 40
shot chord_page.png
spin K2 10
wait 300
said Throws 80
expect par111 80
spin K3 10
wait 300
said Wet 55
expect par115 55
spin K3 -10
tap ARP
wait 300
said Pings page, voice Blip: Density 30, Octave 0, Wet 70, Cloud 30
shot pings_page.png
spin K3 -10
wait 300
said Wet 60
expect par112 60
spin K2 1
wait 300
said Octave +1
expect par21 1
spin K2 -1
tap LFO
wait 300
said Bass page, voice Sub: Density 90, Octave 0, Groove Offbeat, Fifth 20
shot bass_page.png
spin K1 -40
wait 300
said Density 50
expect par113 50
spin K3 3
wait 300
said Groove Roller
expect par24 4
spin K3 -1
wait 300
said Groove Sync
spin K3 -10
wait 300
said Groove Drone
spin K3 1
expect par24 1
spin K1 40
tap SEQ
wait 300
said Drums page, kit Tight: Density 97, Hits 10, Hats 40, Tone 0
shot drums_page.png
spin K3 10
wait 300
said Hats 50
expect par114 50
spin K1 -10
wait 300
said Density 87
expect par116 87
spin K1 10
tap SAVE
wait 300
said Noise page, character Vinyl: Density 0, Air 0, Tone 0, Decay 50
shot noise_page.png
tap SEQ
# OCT- / OCT+ on each layer's page: its level, 5 a tap (said in the header); held: on, every 100 ms after 400 ms
# on a layer's page the middle that layer's alone (its notes the ripples, its sound the scope and the spectrum)
wait 100
expect viewlayer 4
tap ENV
wait 200
expect viewlayer 1
expect octring 0
tap OCT-
said CHORD 71
expect par0 71
# the level ring in the middle, in the layer's colour, for 1.2 s after the last press, then fading
expect octring 1
wait 300
shot octring.png
wait 1300
expect octring 0
tap OCT+
said CHORD 76
expect par0 76
press OCT-
wait 1050
release OCT-
expect par0 41
press OCT+
wait 300
release OCT+
expect par0 46
press OCT+
wait 4000
release OCT+
expect par0 100
tap ENV
expect view 8
tap OCT-
expect par0 95
tap ENV
expect view 12
tap OCT-
expect par0 90
tap ARP
tap OCT+
said PINGS 35
expect par1 35
tap ARP
tap OCT-
expect par1 30
tap LFO
tap OCT-
said BASS 63
expect par2 63
tap SEQ
tap OCT-
said DRUMS 75
expect par3 75
tap SEQ
tap SEQ
expect view 16
tap OCT+
expect par3 80
tap SAVE
tap OCT+
said NOISE 13
expect par29 13
tap HOME
# both together, let go quickly: the layer muted, its level kept; again: back
tap LFO
press OCT-
press OCT+
wait 200
release OCT-
release OCT+
wait 100
said BASS MUTED
expect mutes 4
expect octring 3
wait 200
shot octring_muted.png
expect par2 63
# PERFORM's lights follow it (white 3, the bass, dark), and its key brings it back
tap SEL
wait 100
expect litkey4 0
expect litkey0 1
tapkey w2
wait 100
said BASS ON
expect mutes 0
expect litkey4 1
expect viewlayer 0
# and the other way: muted in PERFORM, back on OCT
tapkey w2
expect mutes 4
tap LFO
wait 100
press OCT+
press OCT-
wait 100
release OCT+
release OCT-
wait 100
said BASS ON
expect mutes 0
# the drums: the kick and the hats together
tap SEQ
press OCT-
press OCT+
wait 150
release OCT+
release OCT-
said DRUMS MUTED
expect mutes 24
expect par3 80
tap SEL
wait 100
expect litkey6 0
expect litkey7 0
tap SEQ
press OCT-
press OCT+
wait 150
release OCT+
release OCT-
said DRUMS ON
expect mutes 0
# the chord and the pings
tap ENV
press OCT-
press OCT+
wait 150
release OCT+
release OCT-
said CHORD MUTED
expect mutes 1
press OCT-
press OCT+
wait 150
release OCT+
release OCT-
expect mutes 0
tap ARP
press OCT-
press OCT+
wait 150
release OCT+
release OCT-
said PINGS MUTED
expect mutes 2
press OCT-
press OCT+
wait 150
release OCT+
release OCT-
expect mutes 0
# the noise: muted (its level kept, turned while muted), back at its level
tap SAVE
press OCT-
press OCT+
wait 150
release OCT+
release OCT-
said NOISE MUTED
expect mutes 32
expect par29 13
tap OCT+
expect par29 18
expect mutes 32
press OCT-
press OCT+
wait 150
release OCT+
release OCT-
said NOISE ON
expect mutes 0
expect par29 18
tap HOME
# both held longer (on the device, held 5 s: the update mode, counted from 2 s): no mute, no steps
tap LFO
press OCT-
press OCT+
wait 1500
release OCT-
release OCT+
wait 100
said_none MUTED
expect mutes 0
expect par2 63
# elsewhere (the Dub page, the Chords page) OCT does nothing for now
tap HOME
wait 300
tap OCT+
tap OCT-
press OCT-
press OCT+
wait 150
release OCT+
release OCT-
wait 100
said_none MUTED
said_none CHORD
expect mutes 0
expect par0 90
expect par21 0
tap EDIT
expect view 15
tap OCT+
press OCT-
press OCT+
wait 150
release OCT+
release OCT-
expect mutes 0
expect par0 90
tap HOME
# a 1.3.0 ladder project (format 12): the groove a ladder step, now a pattern and Notes (Basic's, Thin sync: Sync
# at 65); the other pieces' full steps their patterns at 100; Throws, Ghost, Hats level from the recipes
turn PRESET 2
wait 300
expect par24 2
turn PRESET -2
wait 300
store12 5
reboot
wait 1000
expect format 17
expect piece 0
expect par24 3
expect par113 65
expect par111 70
expect par112 70
expect par114 40
expect par0 90
turn PRESET 2
wait 300
expect par24 2
expect par113 100
turn PRESET -2
wait 300
expect par24 3
expect par113 65
# a 1.3.0 pages project (format 13): everything kept, the chord's Ghost .. the shimmer's Tune from the recipes
tap ARP
wait 300
expect view 2
spin K3 10
wait 300
expect par112 80
