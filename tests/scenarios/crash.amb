# the grid's Crash (REC held, white 10): a burst into the plate at about the music's own level, never far over it
# (1.3.0: it was white noise 15 dB over the music)
listen
wait 6000
peakreset
wait 3000
expect peak_db_max <-14
press REC
wait 300
key w9 down
wait 200
key w9 up
release REC
said Crash
peakreset
wait 1500
expect peak_db_max <-12
