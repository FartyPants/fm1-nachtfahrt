# the scale: on the Key page's knobs (Root, Mode: once a song, the user), not the keys (they play the Lead); MIDI in
# still edits it (a note in or out, the root stays, three notes at least)
wait 300
# the first piece is in Dorian; its root to C (HOME on the Berlin page, the Key page: KNOB 2, down to its lowest)
expect par20 1
tap HOME
wait 200
expect view 18
spin K2 -12
expect par19 0
# C Dorian: C D Eb F G A Bb; the keys leave it be (E4, key 11, plays the Lead)
expect pool 0x6AD
tapkey 11
expect pool 0x6AD
# the next mode: Mixolydian (the Key page's KNOB 3; the modes the most common first: Aeolian, Ionian,
# Dorian, Mixolydian, pentatonic minor and major, Phrygian, Lydian)
spin K3 1
expect par20 4
expect pool 0x6B5
spin K3 -1
expect par20 1
expect pool 0x6AD
# the root up a tone: D Dorian (the pool is relative to the root: the same)
spin K2 2
expect par19 2
expect pool 0x6AD
wait 300
shot d_dorian.png
# pentatonic minor (two on from Dorian)
spin K3 2
expect par20 7
expect pool 0x4A9
# MIDI in, channel 1: D pent min (D F G A C); F (note 53) out, G (55) out, A (57) would leave two: stays
midi 90 35 64
midi 90 37 64
wait 20
expect pool 0x481
midi 90 39 64
wait 20
expect pool 0x481
# G back in
midi 90 37 64
wait 20
expect pool 0x4A1
expect dirty 1
