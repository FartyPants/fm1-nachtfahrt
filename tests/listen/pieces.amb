# the eight pieces, three minutes of each from its start (PRESETS turned a step each time), a shot each:
# for the ear and tools/analyze_wav.py (levels, bands)
wait 300
expect piece 0
# Timewind
wav pieces_0_timewind.wav
wait 180000
wavstop
shot pieces_0_timewind.png
turn PRESET 1
wait 300
expect piece 1
# Wahnfried
wav pieces_1_wahnfried.wav
wait 180000
wavstop
shot pieces_1_wahnfried.png
turn PRESET 1
wait 300
expect piece 2
